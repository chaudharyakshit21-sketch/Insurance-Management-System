<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Premium_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Premium amount must be greater than zero.</description>
    <errorConditionFormula>Premium_Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Premium_Amount__c</errorDisplayField>
    <errorMessage>Premium amount must be greater than zero.</errorMessage>
</ValidationRule>
