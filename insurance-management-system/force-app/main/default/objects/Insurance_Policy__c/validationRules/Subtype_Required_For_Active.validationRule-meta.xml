<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Subtype_Required_For_Active</fullName>
    <active>true</active>
    <description>Select a policy subtype before activating the policy.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Active"), ISBLANK(TEXT(Policy_Subtype__c)))</errorConditionFormula>
    <errorDisplayField>Policy_Subtype__c</errorDisplayField>
    <errorMessage>Select a policy subtype before activating the policy.</errorMessage>
</ValidationRule>
