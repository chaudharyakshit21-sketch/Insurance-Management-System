<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Must_Be_18</fullName>
    <active>true</active>
    <description>Customer must be at least 18 years old.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Date_of_Birth__c)), ADDMONTHS(Date_of_Birth__c, 216) &gt; TODAY())</errorConditionFormula>
    <errorDisplayField>Date_of_Birth__c</errorDisplayField>
    <errorMessage>Customer must be at least 18 years old.</errorMessage>
</ValidationRule>
