<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Claim_Date_Not_In_Future</fullName>
    <active>true</active>
    <description>Claim date cannot be in the future.</description>
    <errorConditionFormula>Claim_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Claim_Date__c</errorDisplayField>
    <errorMessage>Claim date cannot be in the future.</errorMessage>
</ValidationRule>
