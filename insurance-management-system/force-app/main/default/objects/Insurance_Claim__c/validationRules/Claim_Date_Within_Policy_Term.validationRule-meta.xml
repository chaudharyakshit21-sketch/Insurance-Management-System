<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Claim_Date_Within_Policy_Term</fullName>
    <active>true</active>
    <description>Claim date must fall within the policy term.</description>
    <errorConditionFormula>OR(Claim_Date__c &lt; Policy__r.Start_Date__c, Claim_Date__c &gt; Policy__r.End_Date__c)</errorConditionFormula>
    <errorDisplayField>Claim_Date__c</errorDisplayField>
    <errorMessage>Claim date must fall within the policy term.</errorMessage>
</ValidationRule>
